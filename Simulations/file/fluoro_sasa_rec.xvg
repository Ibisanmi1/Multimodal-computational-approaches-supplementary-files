@    title "Solvent Accessible Surface"
@    xaxis  label "Time (ps)"
@    yaxis  label "Area (nm\S2\N)"
@TYPE xy
@ view 0.15, 0.15, 0.75, 0.85
@ legend on
@ legend box on
@ legend loctype view
@ legend 0.78, 0.8
@ legend length 2
@ s0 legend "Total"
